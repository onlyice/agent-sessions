{
  "name": "agent-session-list",
  "version": "1.9.4",
  "description": "Browse, search and resume Coding Agent sessions (Claude Code, Codex, OpenCode, Pi, Amp)",
  "main": "./out/main/index.mjs",
  "author": "kevin.lin",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "postinstall": "node scripts/ensure-electron.mjs && electron-rebuild -f -w better-sqlite3",
    "rebuild:sqlite": "electron-rebuild -f -w better-sqlite3",
    "dist": "electron-vite build && electron-builder --mac"
  },
  "dependencies": {
    "@fontsource/fira-code": "^5.2.7",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/open-sans": "^5.2.7",
    "better-sqlite3": "^12.10.0",
    "dompurify": "^3.4.7",
    "lucide-react": "^1.17.0",
    "marked": "^18.0.4"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^41.7.1",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  },
  "build": {
    "productName": "Agent Sessions",
    "mac": {
      "identity": null
    }
  },
  "packageManager": "pnpm@11.1.3+sha512.c85357fe17ca12dd23dd7071822666dfd7e3cb76fe214e3370b5ea2fb34f2a231185509b63e717f3cd0acb38dd3f8d82bcd5e8172400ae678b70ea4fbed0896d"
