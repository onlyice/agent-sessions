{
  "include": ["src/renderer/src/**/*", "src/preload/index.d.ts"],
  "compilerOptions": {
    "composite": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "module": "ESNext",
    "target": "ES2022",
    "outDir": "out-tsc/web",
    "paths": {
      "@renderer/*": ["./src/renderer/src/*"]
    }
  }
}
